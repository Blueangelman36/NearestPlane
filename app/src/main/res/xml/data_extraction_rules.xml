<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the same exclusion, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/station.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/station.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
